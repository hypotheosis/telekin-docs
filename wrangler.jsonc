{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "telekin-docs",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Workers Builds runs `wrangler preview` for non-production branches, and that
  // command needs this block to exist. It can stay empty: this site has no
  // bindings or vars, and assets stay at the top level.
  "previews": {}
}
