---
import { WAITLIST_FORM_ID } from '../site-config.mjs';
const tools = ['Claude', 'ChatGPT', 'Claude Code', 'Cursor', 'VS Code', 'Other'];
---
<form
  data-forminit
  data-form-id={WAITLIST_FORM_ID}
  data-thanks="Thanks! You're on the list. We'll email you when there's a spot."
  method="post"
>
  <p>
    <label for="wl-email">Email</label><br />
    <input id="wl-email" type="email" name="fi-sender-email" required autocomplete="email" />
  </p>
  <p>
    <label for="wl-name">Name</label><br />
    <input id="wl-name" type="text" name="fi-sender-fullName" autocomplete="name" />
  </p>
  <fieldset>
    <legend>Which AI tools do you use?</legend>
    {tools.map((tool) => (
      <label style="display: block;">
        <input type="checkbox" name="fi-checkbox-tools[]" value={tool} /> {tool}
      </label>
    ))}
  </fieldset>
  <p>
    <label for="wl-hopes">What would you want your AI to remember about you?</label><br />
    <textarea id="wl-hopes" name="fi-text-hopes" rows="4" style="width: 100%; max-width: 32rem;"></textarea>
  </p>
  <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" style="display: none;" aria-hidden="true" />
  <p><button type="submit">Join the waitlist</button></p>
  <p><small>We'll only use your email to tell you when there's a spot.</small></p>
  <p data-form-status role="status"></p>
</form>

<script>
  import "../scripts/forminit-forms.ts";
</script>
